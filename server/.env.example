# Server Environment Variables (Keep Private & Safe)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Optional Supabase Service Role Key for Admin Operations (Backend only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
# Google GenAI / Gemini API Key for Explainability and TrustBridge Assistant
GEMINI_API_KEY=your_gemini_api_key_here
