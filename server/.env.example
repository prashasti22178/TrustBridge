# Server Environment Variables (Keep Private & Safe)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Optional Supabase Service Role Key for Admin Operations (Backend only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
# Google GenAI / Gemini API Key for Explainability and TrustBridge Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Opt in only for local synthetic-data evaluation. Always false in production.
ENABLE_DEMO_AUTH=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
